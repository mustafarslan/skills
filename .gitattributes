# Scripts must keep LF endings: a CRLF checkout on Windows turns the shebang into `bash\r`.
*.sh               text eol=lf
*.py               text eol=lf
skills/agy/scripts/agy-ask text eol=lf
skills/park/scripts/park text eol=lf
plugins/power-saver/scripts/power-saver text eol=lf
# Windows PowerShell 5.1 scripts: CRLF on checkout, as Windows tools expect.
plugins/power-saver/scripts/*.ps1 text eol=crlf
plugins/reclaim/scripts/reclaim text eol=lf
plugins/*/scripts/update-check text eol=lf
plugins/reclaim/scripts/*.ps1 text eol=crlf
# Captured command output, byte for byte (wsl.exe prints UTF-16).
plugins/reclaim/tests/fixtures/** -text
